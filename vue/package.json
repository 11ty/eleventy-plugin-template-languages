	},
	"11ty": {
		"compatibility": ">=3.0.0"
	},
	"dependencies": {
		"@11ty/eleventy-utils": "^2.0.7",
		"@vue/server-renderer": "^3.5.41",
		"obug": "^2.2.1",
		"rollup": "^4.64.10",
		"rollup-plugin-css-only": "^4.5.5",
		"rollup-plugin-vue": "^6.0.0",
		"tinyglobby": "^0.2.17",
		"vue": "^3.5.41"
	},
	"devDependencies": {
		"postcss-nested": "^9.0.0"
	}
